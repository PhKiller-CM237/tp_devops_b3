apiVersion: v1
kind: Secret
metadata:
  name: icgroup-secrets
  namespace: icgroup
  labels: {env: prod}
type: Opaque
stringData:
  postgres-password: {{ vault_postgres_password | to_json }}
  pgadmin-password: {{ vault_pgadmin_password | to_json }}
  odoo-admin-password: {{ vault_odoo_admin_password | to_json }}
  pgpass: {{ ("postgres:5432:*:odoo:" ~ vault_postgres_password ~ "\n") | to_json }}
  odoo.conf: |
    [options]
    admin_passwd = {{ vault_odoo_master_password }}
    db_host = postgres
    db_port = 5432
    db_user = odoo
    db_password = {{ vault_postgres_password }}
    db_name = legeni
    dbfilter = ^legeni$
    list_db = False
    proxy_mode = True
    data_dir = /var/lib/odoo
    workers = 0
    max_cron_threads = 1
