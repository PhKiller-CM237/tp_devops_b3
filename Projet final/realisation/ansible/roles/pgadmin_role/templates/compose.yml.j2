services:
  {{ pgadmin_service_name }}:
    image: {{ pgadmin_image }}
    container_name: {{ pgadmin_container_name }}
    environment:
      PGADMIN_DEFAULT_EMAIL: {{ pgadmin_email | to_json }}
      PGADMIN_DEFAULT_PASSWORD: {{ vault_pgadmin_password | to_json }}
      PGADMIN_DISABLE_POSTFIX: "1"
      PGADMIN_REPLACE_SERVERS_ON_STARTUP: "True"
      PGPASS_FILE: /run/secrets/pgpass
    ports: ["5050:80"]
    volumes:
      - pgadmindata:/var/lib/pgadmin
      - ./servers.json:/pgadmin4/servers.json:ro
      - ./pgpass:/run/secrets/pgpass:ro
    networks: [backend]
    restart: unless-stopped
networks:
  backend:
    name: {{ pgadmin_network }}
volumes:
  pgadmindata:
    name: {{ pgadmin_volume }}
